<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.2</version>
        <relativePath/>
    </parent>

    <groupId>io.github.selvitopu</groupId>
    <artifactId>atm-supervisor-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>ATM Supervisor (parent)</name>
    <description>SNMP technical supervision demo for a fictional air traffic control centre</description>

    <modules>
        <module>mib</module>
        <module>inventory</module>
    </modules>

    <properties>
        <java.version>25</java.version>
        <snmp4j.version>3.13.2</snmp4j.version>
        <spring-modulith.version>2.1.2</spring-modulith.version>
        <springdoc.version>3.2.0</springdoc.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.snmp4j</groupId>
                <artifactId>snmp4j</artifactId>
                <version>${snmp4j.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springframework.modulith</groupId>
                <artifactId>spring-modulith-bom</artifactId>
                <version>${spring-modulith.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>io.github.selvitopu</groupId>
                <artifactId>mib</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.selvitopu</groupId>
                <artifactId>atm-inventory</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
